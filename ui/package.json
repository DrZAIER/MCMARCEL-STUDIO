{
  "name": "mcmarcel-studio-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "cargo build --manifest-path ../src-tauri/Cargo.toml && ../src-tauri/target/debug/mcmarcel-desktop.exe",
    "icons": "node ../scripts/generate-icons.mjs",
    "site": "node scripts/build-site.mjs --out site/dist"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "marked": "^18.1.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
